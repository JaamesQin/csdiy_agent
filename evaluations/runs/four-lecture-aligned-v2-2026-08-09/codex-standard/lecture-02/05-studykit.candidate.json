  "common_misconceptions": [
    {
      "misconception": "反向传播本身会更新参数。",
      "correction": "反向传播产生梯度；更新是随后使用梯度的独立阶段。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 42
          }
        }
      ]
    },
    {
      "misconception": "每个节点必须处处光滑。",
      "correction": "ReLU 在零点不光滑，讲义仍将它作为可用节点。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 24
          }
        }
      ]
    },
    {
      "misconception": "批量总梯度需要先把样本拼成一个新公式。",
      "correction": "平均损失的梯度就是各样本梯度的平均。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 45
          }
        }
      ]
    },
    {
      "misconception": "分支只沿一条路径回传。",
      "correction": "影响同一上游量的所有路径贡献都要相加。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 53
          }
        }
      ]
    },
    {
      "misconception": "只能对权重求梯度。",
      "correction": "任意节点或边都可相对于标量代价求导，包括输入。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 61
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 66
          }
        }
      ]
    }
