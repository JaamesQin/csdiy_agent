  "core_concepts": [
    {
      "id": "cc-1",
      "term": "经验损失目标",
      "claim_type": "source_summary",
      "explanation": "训练目标把每个样本经过模型后的损失汇总，并在参数空间中寻找极小值。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 5
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^*=\\arg\\min_\\theta\\sum_{i=1}^{N}\\mathcal L(f_\\theta(x^{(i)}),y^{(i)})",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-2",
      "term": "梯度下降更新",
      "claim_type": "source_summary",
      "explanation": "梯度下降使用一阶导数；每步从当前参数沿负梯度方向移动，η 是学习率。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^{k+1}=\\theta^k-\\eta\\nabla_\\theta J(\\theta^k)",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-3",
      "term": "SGD 与 batch",
      "claim_type": "source_summary",
      "explanation": "SGD 用一个数据子集估计总体梯度。batch=1 时逐样本更新，batch=N 时等于标准梯度下降；小批量更快但方向噪声更大。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ]
    },
    {
      "id": "cc-4",
      "term": "动量",
      "claim_type": "source_summary",
      "explanation": "动量把上一更新方向带入当前步；其强度是超参数，讲义明确说明它可能有帮助也可能有害。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^{t+1}=\\theta^t-\\eta\\nabla f(\\theta^t)-\\alpha m^t",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-5",
      "term": "优化故障模式",
      "claim_type": "source_summary",
      "explanation": "局部极小值影响终点；梯度消失或为零使进展停滞；梯度爆炸导致不稳定和越界。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 14
          }
        }
      ]
    },
    {
      "id": "cc-6",
      "term": "梯度裁剪",
      "claim_type": "source_summary",
      "explanation": "若梯度分量超过阈值 m，讲义用 clip 把它限制在区间内，以缓解爆炸梯度造成的不稳定。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 22
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^{k+1}=\\theta^k-\\eta[\\operatorname{clip}(v_1,-m,m),\\ldots,\\operatorname{clip}(v_M,-m,m)]^\\top",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 22
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-7",
      "term": "ReLU 与可微要求",
      "claim_type": "source_summary",
      "explanation": "ReLU 连续但在零点并非通常意义下可微，也不处处光滑；讲义以它说明实用节点不必满足“处处光滑”。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 24
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\operatorname{ReLU}(z)=\\max(0,z)",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 24
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-8",
      "term": "计算图",
      "claim_type": "source_summary",
      "explanation": "深度学习主要使用由可微函数节点组成的有向无环计算图；多层网络的前向过程沿依赖方向计算到标量损失。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 26
          }
        }
      ]
    },
    {
      "id": "cc-9",
      "term": "Jacobian 链式法则",
      "claim_type": "source_summary",
      "explanation": "讲义把标量对列向量的导数写作行向量、向量对向量的导数写作 Jacobian；复合映射按维度匹配的顺序相乘。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 34
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\frac{\\partial z}{\\partial x}=\\frac{\\partial z}{\\partial u}\\frac{\\partial u}{\\partial x}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 34
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-10",
      "term": "反向传播复用",
      "claim_type": "source_summary",
      "explanation": "不同参数的链式展开共享靠近损失端的导数项；反向传播只计算共享项一次，再从输出向输入传播。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 36
          }
        }
      ]
    },
    {
      "id": "cc-11",
      "term": "通用层局部反向",
      "claim_type": "source_summary",
      "explanation": "对层 x_out=f(x_in,θ)，输出侧梯度分别与输入 Jacobian 和参数 Jacobian 组合，得到输入梯度与参数梯度。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 41
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "g_{in}=g_{out}L^x,\\qquad \\frac{\\partial J}{\\partial\\theta}=g_{out}L^\\theta",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 41
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-12",
      "term": "批次平均梯度",
      "claim_type": "source_summary",
      "explanation": "平均数据损失对参数的梯度，就是各数据点损失梯度的平均。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 45
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\frac{\\partial J}{\\partial\\theta}=\\frac1N\\sum_{i=1}^N\\frac{\\partial J_i(x^i,\\theta)}{\\partial\\theta}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 45
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-13",
      "term": "线性层反向",
      "claim_type": "source_summary",
      "explanation": "对 x_out=W x_in，在讲义的行梯度约定下，输入梯度是 g_out W；权重梯度由输入列向量与输出侧行梯度组成外积。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 46
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "x_{out}=Wx_{in},\\qquad g_{in}=g_{out}W",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 46
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-14",
      "term": "DAG 分支与共享参数",
      "claim_type": "source_summary",
      "explanation": "同一上游量沿多个分支影响损失时，各路径梯度在回到该量时相加；同一参数多次使用时也汇总全部使用点的贡献。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 55
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\frac{\\partial J}{\\partial x}=\\sum_i\\frac{\\partial J}{\\partial x^i}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 55
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-15",
      "term": "对输入求梯度",
      "claim_type": "source_summary",
      "explanation": "反向传播可对计算图中的节点或边相对于任意标量代价求导。单元可视化固定网络，沿输入梯度上升并加入正则项。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 66
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "x^{k+1}=x^k+\\eta\\left.\\frac{\\partial(y_j(x)+\\lambda R(x))}{\\partial x}\\right|_{x=x^k}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 66
          }
        },
        "warnings": []
      }
    }
  ],
  "glossary": [
    {
      "term": "梯度",
      "definition": "标量目标对各变量分量的一阶导数集合。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
