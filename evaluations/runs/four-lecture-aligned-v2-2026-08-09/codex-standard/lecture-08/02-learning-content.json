          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 52
          }
        }
      ]
    },
    {
      "term": "cross-attention",
      "definition": "queries 与 keys/values 来自不同 token 集合的注意力。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
