  "glossary": [
    {
      "term": "code vector",
      "definition": "一个 token 内部的神经元向量。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 11
          }
        }
      ]
    },
    {
      "term": "attention matrix",
      "definition": "由输入相关匹配构造、用于混合 values 的权重矩阵。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 20
          }
