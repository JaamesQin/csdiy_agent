  "common_misconceptions": [
    {
      "misconception": "token mixing 等同于普通全连接层在通道上的变换。",
      "correction": "本讲的 W 左乘 token 矩阵，混合的是行所代表的 tokens。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 17
          }
        }
      ]
    },
    {
      "misconception": "attention 权重就是训练后固定的参数 W。",
      "correction": "A 由当前数据动态构造。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 20
          }
        }
      ]
    },
    {
      "misconception": "置换等变意味着输出完全不变。",
      "correction": "输出按输入的相同置换重新排列。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 41
          }
        }
      ]
    },
    {
      "misconception": "多头注意力让每个 head 共享同一 Q/K/V 参数。",
      "correction": "每个 head 有自己的参数化 Q/K/V 函数。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 37
          }
        }
      ]
    },
    {
      "misconception": "自回归训练必须按位置串行运行。",
      "correction": "causal mask 允许一次前向过程同时产生多个位置的监督预测。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 51
          }
        }
      ]
    }
  ],
