  "common_misconceptions": [
    {
      "misconception": "卷积会自动让任何输出对平移不变。",
      "correction": "卷积首先提供平移等变；池化或任务读出才可能形成某种不变性。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 23
