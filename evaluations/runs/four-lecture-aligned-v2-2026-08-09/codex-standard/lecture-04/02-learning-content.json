  "core_concepts": [
    {
      "id": "C1",
      "term": "受约束假设空间",
      "claim_type": "source_summary",
      "explanation": "架构把所有可想象映射限制为更小的可表示集合。若真实映射仍在集合中，结构约束可与增加数据一样帮助排除不合适解；但架构也要可优化、可并行且计算可承受。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 6
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ]
    },
    {
      "id": "C2",
      "term": "逼近与优化的实验耦合",
      "claim_type": "source_summary",
      "explanation": "课堂展示不同网络拟合图像的差异，同时明确提醒：结果可能来自逼近能力，也可能来自优化能力，实际实验通常无法把二者完全拆开。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ]
    },
    {
      "id": "C3",
      "term": "语义分割的局部上下文矛盾",
      "claim_type": "source_summary",
      "explanation": "逐像素输出要求高空间分辨率，而过小图块又缺少辨认物体所需的上下文。较大、重叠且共享处理的窗口兼顾密集输出和上下文。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 19
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 22
          }
        }
      ]
    },
    {
      "id": "C4",
      "term": "平移等变",
      "claim_type": "source_summary",
      "explanation": "若每个位置都应用相同局部函数，移动输入后所得输出会相应移动。它描述输入变化如何传递到输出，不表示输出数值或位置保持不变。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 23
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 36
          }
        }
      ]
    },
    {
      "id": "C5",
      "term": "卷积即受约束线性层",
      "claim_type": "source_summary",
      "explanation": "卷积核对邻域做共享加权组合；从矩阵角度看，这是一种具有重复结构的受约束线性层，因此参数少于任意稠密连接。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 24
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 25
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 32
          }
        }
      ]
    },
    {
      "id": "C6",
      "term": "多输入与多输出通道",
      "claim_type": "source_summary",
      "explanation": "神经网络卷积把各输入通道的局部响应组合起来，并用一组滤波器产生多个输出特征图；每个输出通道对应一个学习到的响应图。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 31
          }
        }
      ]
    },
    {
      "id": "C7",
      "term": "五种卷积视角",
      "claim_type": "source_summary",
      "explanation": "卷积可同时理解为平移等变映射、滑动块处理、图像滤波、参数共享，以及处理可变尺寸张量的方法。这些不是五种不同操作，而是同一结构的五种解释。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 34
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 36
          }
        }
      ]
    },
    {
      "id": "C8",
      "term": "感受野随深度扩大",
      "claim_type": "source_summary",
      "explanation": "卷积单元只看局部输入，但层层复合会让更深单元依赖更大的原始区域；逐点非线性不改变空间依赖范围，下采样会更快扩大相对感受野。",
      "citations": [
        {
