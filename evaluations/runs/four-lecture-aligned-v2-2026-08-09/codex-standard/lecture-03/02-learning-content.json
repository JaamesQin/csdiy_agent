  "core_concepts": [
    {
      "id": "K1",
      "term": "逼近、优化、泛化",
      "claim_type": "source_summary",
      "explanation": "逼近问模型族中是否存在拟合函数，优化问能否找到它，泛化问未见数据上是否有效；本讲集中于逼近。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "id": "K2",
      "term": "L-Lipschitz 条件",
      "claim_type": "source_summary",
      "explanation": "函数输出变化的绝对值不超过输入变化的 L 倍；多维输入使用 RMS 范数。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "|g(x+\\\\Delta x)-g(x)|\\\\le L|\\\\Delta x|",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        "warnings": []
      }
    },
    {
      "id": "K3",
      "term": "RMS 范数",
      "claim_type": "source_summary",
      "explanation": "RMS 范数等于各坐标平方平均的平方根，表示向量坐标的平均尺度。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\\\|x\\\\|_{\\\\mathrm{RMS}}=\\\\sqrt{\\\\frac1d\\\\sum_{i=1}^{d}x_i^2}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
        "warnings": []
      }
    },
    {
      "id": "K4",
      "term": "三层 ReLU 逼近定理",
      "claim_type": "source_summary",
      "explanation": "单位 d 维超立方体上的任意 L-Lipschitz 函数，对任意 ε>0，存在规模为 4d(L/ε)^d 的三层 ReLU 网络，使积分 L1 误差小于 2ε。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "N=4d(L/\\\\varepsilon)^d,\\\\quad\\\\int_{[0,1]^d}|f(x)-g(x)|\\\\,dx<2\\\\varepsilon",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        "warnings": []
      }
    },
    {
      "id": "K5",
      "term": "一维分片矩形误差",
      "claim_type": "source_summary",
      "explanation": "N 条等宽区间中，每条的最大偏差形成底 1/N、高 L/N 的三角形；总面积不超过 L/(2N)，故 N=L/(2ε) 足以达到 ε。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 12
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 13
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\\\int |f-g|\\\\le N\\\\cdot\\\\frac12\\\\frac1N\\\\frac LN=\\\\frac{L}{2N}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 13
          }
        },
        "warnings": []
      }
    },
    {
      "id": "K6",
      "term": "高维矩形逼近",
      "claim_type": "source_summary",
      "explanation": "N 个超矩形边长 N^{-1/d}，误差帽高度 L/N^{1/d}，合计误差不超过 L/N^{1/d}；达到 ε 需 N=(L/ε)^d。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 14
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "N=(L/\\\\varepsilon)^d",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        "warnings": []
      }
    },
    {
      "id": "K7",
      "term": "一维 ReLU 矩形",
      "claim_type": "source_summary",
      "explanation": "四个带平移的 ReLU 按 +1,-1,-1,+1 线性组合，在 c→∞ 时逼近 [0,1] 的矩形指示；权重和偏置可平移矩形。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 15
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "f_c(x)=[1,-1,-1,1]^\\\\top\\\\operatorname{ReLU}([cx,cx-1,c(x-1)-2,c(x-1)-3]^\\\\top)",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 15
          }
        },
        "warnings": []
      }
    },
    {
      "id": "K8",
      "term": "超矩形门与线性组合",
      "claim_type": "source_summary",
      "explanation": "各坐标的一维矩形全部开启时，和才超过 d−1；在该阈值施加 ReLU 得到超矩形，再用带位置参数的超矩形线性组合逼近曲面。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 16
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 17
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "h_c(x)=\\\\operatorname{ReLU}(\\\\sum_{i=1}^{d}f_c(x_i)-(d-1)),\\\\quad f(x)=\\\\sum_i\\\\alpha_i h_c(x-u_i)",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 17
          }
        },
        "warnings": []
      }
    },
