    {
      "id": "K11",
      "term": "ReLU 网络的分段线性性",
      "claim_type": "source_summary",
      "explanation": "ReLU 本身分段线性，分段线性函数对和、复合、标量乘法封闭，因此 ReLU 网络可用梯度改变处 kink 的数量分析。",
      "citations": [
