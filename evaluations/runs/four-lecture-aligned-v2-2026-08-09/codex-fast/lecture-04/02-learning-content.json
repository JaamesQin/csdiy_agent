  "core_concepts": [
    {
      "id": "k1",
      "term": "架构归纳偏置",
      "claim_type": "source_summary",
      "explanation": "更小的架构假设空间可以排除大量与任务结构不符的映射；前提是它仍包含真实解。讲义同时提醒，易优化、可并行和 GPU 效率也是好架构的条件。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 6
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ]
    },
    {
      "id": "k2",
      "term": "密集预测与重叠窗口",
      "claim_type": "source_summary",
      "explanation": "语义分割给每个像素分配类别。若小块缺少识别上下文，可用较大且重叠的块，在保持密集输出的同时看到更多邻域。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 19
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 22
          }
        }
      ]
    },
    {
      "id": "k3",
      "term": "平移等变",
      "claim_type": "source_summary",
      "explanation": "对每个位置施加同一局部规则时，输入移动会使输出以相同方式移动。这里应称等变，而不是把输出理解为保持不变。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 23
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 36
          }
        }
      ]
    },
    {
      "id": "k4",
      "term": "局部性与权重共享",
      "claim_type": "source_summary",
      "explanation": "局部连接假设一个输出仅依赖邻域；在所有位置复用同一组局部权重，就得到卷积网络。受约束的线性结构使用更少参数。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 27
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 28
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 32
          }
        }
      ]
    },
    {
      "id": "k5",
      "term": "卷积的五种视角",
      "claim_type": "source_summary",
      "explanation": "同一操作可以看作平移等变映射、滑窗块处理、图像滤波、参数共享，或处理可变尺寸张量的方法。这五种视角分别强调行为、计算和表示。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 34
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 36
          }
        }
      ]
    },
    {
      "id": "k6",
      "term": "深度与感受野",
      "claim_type": "source_summary",
      "explanation": "堆叠局部卷积后，深层位置依赖更大的输入区域；逐点非线性不扩大感受野，而下采样会让后续位置对应更大的原图范围。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
          "anchor": {
            "type": "page",
            "value": 37
          }
