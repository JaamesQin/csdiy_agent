            "type": "page",
            "value": 46
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "x_{out}=Wx_{in},\\quad g_{in}=g_{out}W",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 46
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-13",
      "term": "分支与参数共享",
      "claim_type": "source_summary",
      "explanation": "一个变量影响多条下游路径时，反向贡献求和；共享参数的各次使用同样需要累加梯度。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
