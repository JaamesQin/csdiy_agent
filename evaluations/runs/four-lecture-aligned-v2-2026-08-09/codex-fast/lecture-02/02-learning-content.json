  "glossary": [
    {
      "term": "梯度",
      "definition": "标量目标对变量各分量的一阶偏导集合。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "term": "Jacobian",
      "definition": "向量输出对向量输入的偏导矩阵。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 32
          }
        }
      ]
    },
    {
      "term": "计算图",
      "definition": "按函数依赖连接节点的图。",
