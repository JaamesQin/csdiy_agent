  "core_concepts": [
    {
      "id": "concept-1",
      "term": "训练目标",
      "claim_type": "source_summary",
      "explanation": "样本损失汇总为目标函数，训练寻找使该目标较小的参数。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 5
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^*=\\arg\\min_\\theta\\sum_{i=1}^N\\mathcal L(f_\\theta(x^{(i)}),y^{(i)})",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-2",
      "term": "梯度下降",
      "claim_type": "source_summary",
      "explanation": "一次更新沿目标函数对参数的负梯度方向移动，学习率控制步长。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^{k+1}=\\theta^k-\\eta\\nabla_\\theta J(\\theta^k)",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-3",
      "term": "SGD 与批量",
      "claim_type": "source_summary",
      "explanation": "SGD 在数据子集上计算梯度；批大小为 1 时逐样本更新，批大小为 N 时是标准梯度下降。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ]
    },
    {
      "id": "concept-4",
      "term": "动量",
      "claim_type": "source_summary",
      "explanation": "动量使当前步倾向延续先前更新方向；动量强度是超参数，并非总能改善优化。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\theta^{t+1}=\\theta^t-\\eta\\nabla f(\\theta^t)-\\alpha m^t",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-5",
      "term": "优化困难与裁剪",
      "claim_type": "source_summary",
      "explanation": "局部极小值、梯度消失、零梯度和梯度爆炸会妨碍优化；裁剪把过大梯度限制到阈值范围。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 22
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "v=\\nabla_\\theta J(\\theta^k)",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 22
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-6",
      "term": "ReLU 的可微性",
      "claim_type": "source_summary",
      "explanation": "讲义用 ReLU 说明实践中的损失或节点不必处处光滑；ReLU 在零点以外可微。",
      "citations": [
