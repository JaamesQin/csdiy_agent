        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 26
          }
        }
      ]
    },
    {
      "term": "反向传播",
      "definition": "复用链式法则共享项的逆向求导算法。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-02-slides",
