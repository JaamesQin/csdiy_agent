          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "x^{k+1}=x^k+\\eta\\left.\\frac{\\partial(y_j(x)+\\lambda R(x))}{\\partial x}\\right|_{x=x^k}",
