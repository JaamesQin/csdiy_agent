          "source_id": "mit-6.7960-f24-lecture-02-slides",
          "anchor": {
            "type": "page",
            "value": 55
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-14",
      "term": "优化输入",
      "claim_type": "source_summary",
      "explanation": "反向传播也可计算标量代价对输入的梯度；单元可视化沿输入梯度上升并可加入正则项。",
