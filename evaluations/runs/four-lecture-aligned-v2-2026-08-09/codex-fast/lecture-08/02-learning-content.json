    {
      "id": "c11",
      "term": "Causal attention",
      "claim_type": "source_summary",
      "explanation": "因果 mask 阻止位置 i 使用未来位置；训练时，多个 next-token 预测可在一次前向传播中并行监督，多层仍保持因果依赖。",
      "citations": [
