  "core_concepts": [
    {
      "id": "c1",
      "term": "局部性与全局依赖",
      "claim_type": "source_summary",
      "explanation": "小卷积核让相距很远的区域在浅层中不能直接交互；注意力允许根据任务动态汇聚远处 token 的信息。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "id": "c2",
      "term": "Token 与 tokenization",
      "claim_type": "source_summary",
      "explanation": "token 是封装信息的向量。图像可切成 patches，再用可学习线性投影映射为 d 维 token；N 个 token 组成矩阵 T∈R^{N×d}。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 11
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 16
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "T\\in\\mathbb{R}^{N\\times d}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 16
          }
        },
        "warnings": []
      }
    },
    {
      "id": "c3",
      "term": "Token 混合",
      "claim_type": "source_summary",
      "explanation": "跨 token 的线性组合对整条 token 向量使用同一个标量权重；矩阵形式是 T_out=W T_in。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 17
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "T_{\\mathrm{out}}[i,:]=\\sum_{j=1}^{N}w_{ij}T_{\\mathrm{in}}[j,:],\\quad T_{\\mathrm{out}}=WT_{\\mathrm{in}}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 17
          }
        },
        "warnings": []
      }
    },
    {
      "id": "c4",
      "term": "逐 token 非线性",
      "claim_type": "source_summary",
      "explanation": "同一个非线性函数 F_θ 独立作用于每个 token；通常由 MLP 实现，功能上类似沿 token 序列运行的 1×1 卷积。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 19
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "T_{\\mathrm{out}}=[F_\\theta(T_{\\mathrm{in}}[0,:]);\\ldots;F_\\theta(T_{\\mathrm{in}}[N-1,:])]",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        "warnings": []
      }
    },
    {
      "id": "c5",
      "term": "Query–Key–Value attention",
      "claim_type": "source_summary",
      "explanation": "query 表示要寻找什么，key 用于匹配，value 是被汇聚的内容。先由线性投影得到 q、k、v，再把 query 与各 key 的相似度经 softmax 归一化，最后对 value 加权求和。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 29
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 32
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "q=W_qt,\\;k=W_kt,\\;v=W_vt,\\quad A=\\operatorname{softmax}(s),\\quad T_{\\mathrm{out}}=AV",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 29
          }
        },
        "warnings": [
          "第29页展示单查询示意；矩阵记号按该页可见标签概括。"
        ]
      }
    },
    {
      "id": "c6",
      "term": "Self-attention",
      "claim_type": "source_summary",
      "explanation": "self-attention 让同一组输入 token 同时提供 queries、keys 与 values，使每个 token 能根据上下文聚合其他 token。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 30
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 32
          }
        }
      ]
    },
    {
      "id": "c7",
      "term": "Multihead self-attention",
      "claim_type": "source_summary",
      "explanation": "k 个 head 各自拥有 Q/K/V 投影并行计算，按 token 位置拼接结果，再以 W_MSA 投影回 d 维。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 37
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "T_{\\mathrm{out}}^{i}=\\operatorname{attn}^{i}(T_{\\mathrm{in}}),\\quad \\bar T_{\\mathrm{out}}\\in\\mathbb{R}^{N\\times kv},\\quad T_{\\mathrm{out}}=\\bar T_{\\mathrm{out}}W_{\\mathrm{MSA}},\\;W_{\\mathrm{MSA}}\\in\\mathbb{R}^{kv\\times d}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 37
          }
        },
        "warnings": []
      }
    },
    {
      "id": "c8",
      "term": "ViT Transformer block",
      "claim_type": "source_summary",
      "explanation": "ViT 块把 token norm、MSA、残差连接、再次 token norm、逐 token MLP 与另一条残差连接组合起来，并重复 L 次。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 38
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 39
          }
        }
      ]
    },
    {
      "id": "c9",
      "term": "置换等变性",
      "claim_type": "source_summary",
      "explanation": "不含位置码的逐 token 层和自注意力对输入 token 的置换作同样置换，因此整个 transformer 是 set-to-set 的置换等变映射，而不是自动感知空间位置。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 35
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 41
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\operatorname{transformer}(\\operatorname{permute}(T_{\\mathrm{in}}))=\\operatorname{permute}(\\operatorname{transformer}(T_{\\mathrm{in}}))",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
            "type": "page",
            "value": 41
          }
        },
        "warnings": []
      }
    },
    {
      "id": "c10",
      "term": "Fourier positional codes",
      "claim_type": "source_summary",
      "explanation": "把坐标在多频率正弦基上编码，并把位置向量加入或拼接到 token 表示，从而让模型区分位置。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-08-slides",
          "anchor": {
