    {
      "id": "cc-10",
      "term": "ReLU 网络是分段线性的",
      "claim_type": "source_summary",
      "explanation": "ReLU、分段线性函数的和、标量乘法与复合仍为分段线性，可用梯度改变的位置 kink 衡量复杂度。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
