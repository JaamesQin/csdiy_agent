    {
      "id": "cc-12",
      "term": "深度分离",
      "claim_type": "source_summary",
      "explanation": "宽度 2 的三角函数每次自复合都使线性区域数翻倍；复合 500 次产生 2^500−1 个 kinks，而三层网络要匹配需约 7×10^49 的宽度。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 32
          }
        },
