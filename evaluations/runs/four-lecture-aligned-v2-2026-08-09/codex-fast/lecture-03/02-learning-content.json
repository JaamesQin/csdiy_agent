    {
      "id": "cc-11",
      "term": "kink 数递推",
      "claim_type": "source_summary",
      "explanation": "宽度为 n 的一层至多把上一层的最大 kink 数乘以 2n，因此深度 L 的上界为 (2n)^L：对固定深度是宽度的多项式，对固定宽度则随深度指数增长。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 28
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 29
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 30
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 31
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\\\mathrm{KINKS}_L\\\\le2n\\\\,\\\\mathrm{KINKS}_{L-1}\\\\le(2n)^L",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 30
          }
        },
