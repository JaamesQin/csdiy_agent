          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "id": "cc-2",
      "term": "Lipschitz 目标函数类",
      "claim_type": "source_summary",
      "explanation": "函数增量由输入增量的 L 倍控制；多维输入采用 RMS 范数。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "|g(x+\\\\Delta x)-g(x)|\\\\le L|\\\\Delta x|",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-3",
      "term": "RMS 范数",
      "claim_type": "source_summary",
      "explanation": "RMS 范数是坐标平方平均后开根号，用来表示多维输入增量大小。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\\\|x\\\\|_{\\\\mathrm{RMS}}=\\\\sqrt{\\\\frac{1}{d}\\\\sum_{i=1}^{d}x_i^2}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-4",
      "term": "三层 ReLU 逼近定理",
      "claim_type": "source_summary",
      "explanation": "任意定义在单位 d 维超立方体上的 L-Lipschitz 函数，都存在三层 ReLU 网络使积分 L1 误差小于 2ε；构造规模为 4d(L/ε)^d。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "N=4d(L/\\\\varepsilon)^d,\\\\quad \\\\int_{[0,1]^d}|f(x)-g(x)|\\\\,dx<2\\\\varepsilon",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-5",
      "term": "一维矩形条误差",
      "claim_type": "source_summary",
      "explanation": "N 条等宽区间内，Lipschitz 条件把单条误差限制在面积 L/(2N²) 的三角形内，总误差不超过 L/(2N)。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 12
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 13
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\\\int |f(x)-g(x)|\\\\,dx\\\\le N\\\\frac{L}{2N^2}=\\\\frac{L}{2N}",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 13
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-6",
      "term": "高维推广与维数代价",
      "claim_type": "source_summary",
      "explanation": "N 个超矩形各边长 N^{-1/d}，总误差不超过 L/N^{1/d}；达到 ε 需 (L/ε)^d 个超矩形，数量对维数指数增长。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "N=(L/\\\\varepsilon)^d",
        "citation": {
          "source_id": "mit-6.7960-f24-lecture-03-slides",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        "warnings": []
      }
    },
    {
      "id": "cc-7",
      "term": "ReLU 矩形模块",
      "claim_type": "source_summary",
      "explanation": "四个平移、缩放的 ReLU 经系数 [1,-1,-1,1] 组合，在 c→∞ 时趋近区间 [0,1] 的矩形函数；偏置可水平平移它。",
