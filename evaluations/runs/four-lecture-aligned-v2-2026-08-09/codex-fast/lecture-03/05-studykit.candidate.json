  "core_concepts": [
    {
      "id": "cc-1",
      "term": "机器学习的三块拼图",
      "claim_type": "source_summary",
      "explanation": "逼近问模型族中是否存在合适网络；优化问能否找到它；泛化问未见数据上是否有效。本讲主要回答第一问。",
      "citations": [
