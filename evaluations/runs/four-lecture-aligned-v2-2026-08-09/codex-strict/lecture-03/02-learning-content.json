    {
      "id": "LO1",
      "objective": "区分逼近、优化与泛化三个问题，并说明本讲结论只覆盖逼近。"
    },
    {
      "id": "LO2",
      "objective": "用 Lipschitz 条件和 L1 误差复述三层 ReLU 网络的矩形逼近证明。"
    },
    {
      "id": "LO3",
      "objective": "推导维数 d、误差 ε 与矩形/神经元数量之间的指数关系。"
    },
    {
      "id": "LO4",
      "objective": "用分段线性函数的折点数解释宽度与深度的表达效率差异。"
    },
    {
      "id": "LO5",
      "objective": "辨析普适逼近与实际训练、泛化、归纳偏置之间的逻辑边界。"
    }
