  "core_concepts": [
    {
      "id": "A1",
      "term": "结构约束与数据",
      "claim_type": "source_summary",
      "explanation": "更受约束的架构把学习限制在较小的映射集合内；只要真实映射仍可表达，结构约束就可能减少仅靠数据排除错误解的负担。好的架构还需便于梯度搜索与并行计算。",
      "citations": [
        {
          "source_id": "mit-6.7960-f24-lecture-04-slides",
