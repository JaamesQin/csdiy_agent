  "unit_stage_contract": {
    "semantic": {
      "stage": "03-practice-flow",
      "required_outputs": [
        "03-practice-flow.json",
        "05-studykit.candidate.json",
        "independent-audit.xhigh.json"
      ],
      "gate": "different-agent independent semantic audit must pass"
    },
    "evidence": {
      "stage": "01-evidence-plan",
      "required_outputs": ["01-evidence-plan.json"],
      "gate": "every selected chunk id and source anchor exists before downstream practice repair"
    },
    "lineage-only": {
      "stage": "lineage-reconciliation",
      "required_outputs": [
        "lineage/provenance metadata"
      ],
      "gate": "lineage identity and parent/build references must reconcile; no content repair"
    },
    "structure-only": {
      "stage": "structure-reconciliation",
      "required_outputs": [
        "structure/metadata checkpoints"
      ],
      "gate": "stage parity, projection, schema and tree integrity must pass; no semantic rewrite"
    }
  },
  "cycle_rules": {
    "ordering": "course order as listed, then unit_id ascending; checkpoint every unit",
    "max_targeted_repairs_per_stage_per_cycle": 1,
    "semantic_repair_boundary": "repair only confirmed blocker scope; synchronize 03, candidate/final projection, citations, hints, expected evidence and evaluation as applicable",
    "audit_boundary": "preserve all historical audits; never overwrite or reinterpret a prior xhigh audit",
    "tree_boundary": "recompute and record the unit tree hash after each stage; stop the unit on mismatch",
    "reuse_rule": "reuse unchanged baseline artifacts only after exact baseline_tree_sha256 verification",
    "independent_gate": "different auditor reads source/chunks, 01-04, candidate/final and review evidence; pass is required before release",
    "loop": "after a blocking independent audit, automatically create a new fingerprinted Round N+1 build containing only residual blockers; do not apply a second repair in the same stage/build",
    "termination": "continue until every requested unit passes deterministic and independent gates; never mark complete on validator-only success"
  },
