  "core_concepts": [
    {
      "id": "c1",
      "term": "经验风险与总体风险",
      "claim_type": "source_summary",
      "explanation": "训练直接最小化训练样本上的经验风险，而目标是在数据分布上的总体风险较小；泛化关注二者差异。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec6-4d0ff8f34e",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "id": "c2",
      "term": "记忆与归纳偏置",
      "claim_type": "source_summary",
      "explanation": "文件柜模型能保存训练样本，却没有为新输入提供可靠规则；拟合之外还要考察系统偏向哪些函数。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec6-4d0ff8f34e",
          "anchor": {
            "type": "page",
            "value": 6
          }
        },
        {
          "source_id": "mit6-7960-f24-lec6-4d0ff8f34e",
          "anchor": {
            "type": "page",
            "value": 19
          }
        }
      ]
    },
    {
      "id": "c3",
      "term": "插值与双下降",
      "claim_type": "source_summary",
      "explanation": "在刚达到零训练误差的插值阈值附近，测试风险可能升高；容量继续增加后，测试风险又可能下降。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec6-4d0ff8f34e",
          "anchor": {
            "type": "page",
            "value": 29
          }
