  "glossary": [
    {
      "term": "empirical risk",
      "definition": "训练样本上的平均损失。"
    },
    {
      "term": "population risk",
      "definition": "数据分布上的期望损失。"
    },
    {
      "term": "interpolation",
      "definition": "把训练样本拟合到零训练误差。"
    },
    {
      "term": "inductive bias",
      "definition": "学习系统在多个拟合解之间的偏好。"
    },
    {
      "term": "implicit regularization",
      "definition": "优化过程对所选解产生的隐含偏好。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "训练误差为零就代表已经泛化。",
      "correction": "零训练误差只说明拟合训练样本。"
    },
    {
      "misconception": "参数越多测试性能必然越差。",
      "correction": "双下降图景包含插值后测试风险再次下降的区域。"
    },
    {
      "misconception": "一种偏置已经完整解释所有深网泛化。",
      "correction": "课件并列多种机制并保留开放问题。"
    }
  ],
