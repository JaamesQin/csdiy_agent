  "core_concepts": [
    {
      "id": "concept-1",
      "term": "语言模型与 LLM 用语边界",
      "claim_type": "source_summary",
      "explanation": "严格的语言模型为完整词序列赋概率。讲义因此指出，使用掩码目标的 BERT 严格说不是这种自回归语言模型；当代“LLM”则常宽泛指用自监督目标预训练的大型 Transformer。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 16
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 17
          }
        }
      ]
    },
    {
      "id": "concept-2",
      "term": "上下文学习",
      "claim_type": "source_summary",
      "explanation": "上下文学习把少量输入—标签示例放入历史，让语言模型从示例推断任务；测试预测可写成在这些示例及新输入条件下的分布。它在推理时改变上下文，而非在该步骤更新模型参数。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 25
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 29
          }
        }
      ]
    },
    {
      "id": "concept-3",
      "term": "提示敏感性",
      "claim_type": "source_summary",
      "explanation": "讲义引用的实验显示：性能可能随示例数增加而饱和，通常受模型规模、示例顺序、标签分布/覆盖及标签词选择影响；这些是特定研究设置中的观察，不能脱离任务与模型直接普遍化。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 34
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 35
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 36
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 40
          }
        }
      ]
    },
    {
      "id": "concept-4",
      "term": "思维链提示",
      "claim_type": "source_summary",
      "explanation": "少样本思维链把人工书写的中间推理步骤作为额外输入示例，模型随后生成步骤和答案；零样本版本用触发语句诱导步骤。讲义报告的提升依赖任务与模型规模，不等价于保证推理忠实或总是正确。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
