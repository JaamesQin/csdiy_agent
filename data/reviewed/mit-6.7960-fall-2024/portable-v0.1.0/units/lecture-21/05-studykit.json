  "glossary": [
    {
      "term": "language model",
      "translation": "语言模型",
      "definition": "为词序列赋概率的模型。"
    },
    {
      "term": "in-context learning",
      "translation": "上下文学习",
      "definition": "通过提示中的示例在推理时指定任务。"
    },
    {
      "term": "verbalizer",
      "translation": "标签词映射",
      "definition": "把任务标签映射到自然语言 token 的规则。"
    },
    {
      "term": "chain-of-thought prompting",
      "translation": "思维链提示",
      "definition": "在输入或输出中引入中间推理步骤的提示方式。"
    },
    {
      "term": "instruction tuning",
      "translation": "指令微调",
      "definition": "用指令—回答数据微调语言模型。"
    },
    {
      "term": "reward",
      "translation": "奖励",
      "definition": "对候选输出质量赋予的标量信号。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "BERT 的掩码目标与完整序列自回归概率完全相同。",
      "correction": "讲义明确区分两者。"
    },
    {
      "misconception": "上下文学习会在每次提示时更新权重。",
      "correction": "示例进入条件上下文，当前推理步骤不需要参数更新。"
    },
    {
      "misconception": "思维链提升证明输出步骤一定忠实。",
      "correction": "讲义只报告特定实验性能，未证明普遍忠实性。"
    },
    {
      "misconception": "本讲完整覆盖了 RLHF 与 DPO。",
      "correction": "末段只建立奖励最大化和策略梯度入口。"
    }
  ],
