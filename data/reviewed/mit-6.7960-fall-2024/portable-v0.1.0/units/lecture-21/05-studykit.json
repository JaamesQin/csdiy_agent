  "learning_objectives": [
    {
      "id": "obj-1",
      "objective": "区分序列概率语言模型、掩码预训练模型与宽泛的 LLM 用语。"
    },
    {
      "id": "obj-2",
      "objective": "把上下文学习写成对示例历史条件化的预测分布。"
    },
    {
      "id": "obj-3",
      "objective": "在实验设置边界内分析示例数量、模型规模、顺序、标签和 verbalizer 的影响。"
    },
    {
      "id": "obj-4",
      "objective": "比较少样本与零样本思维链提示。"
    },
    {
      "id": "obj-5",
      "objective": "解释指令微调的数据来源、目标及其不足。"
    },
    {
      "id": "obj-6",
      "objective": "解释条件语言模型的期望奖励目标为何引出策略梯度。"
    }
  ],
  "prerequisites": [
