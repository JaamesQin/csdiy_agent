            "value": 54
          }
        }
      ]
    },
    {
      "id": "concept-5",
      "term": "指令微调与对齐动机",
      "claim_type": "source_summary",
      "explanation": "指令微调在任务改写数据或人工示范上微调模型，希望激活可泛化的指令遵循模式。讲义进一步以事实错误、有害输出和人类偏好说明仅做指令微调仍不充分，引出 helpful、honest、harmless 的对齐目标。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 71
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 81
          }
        },
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
          "anchor": {
            "type": "page",
            "value": 82
          }
        }
      ]
    },
    {
      "id": "concept-6",
      "term": "期望奖励与策略梯度入口",
      "claim_type": "source_summary",
      "explanation": "把条件语言模型写为 Pθ(y|x)，可把目标设为最大化从该分布采样输出的期望奖励。奖励函数不可微且期望需估计，使普通反向传播不直接适用；讲义由此引出 REINFORCE 等策略梯度方法，但未展开完整 RLHF 或 DPO。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec21-cf73393559",
