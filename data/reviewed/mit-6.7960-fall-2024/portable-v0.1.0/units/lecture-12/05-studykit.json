  "core_concepts": [
    {
      "id": "c1",
      "term": "相似性驱动的好表示",
      "claim_type": "source_summary",
      "explanation": "同类聚集、类别分离、紧凑和对无关扰动稳健是课件列出的好表示性质；相似/不相似配对提供训练反馈。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec12-11bdb82708",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
