          "source_id": "mit6-7960-f24-lec12-11bdb82708",
          "anchor": {
            "type": "page",
            "value": 10
          }
        }
      ]
    },
    {
      "id": "c2",
      "term": "度量学习",
      "claim_type": "source_summary",
      "explanation": "度量学习学习一个变换，使相似样本在表示空间靠近、不相似样本远离；深度方法把线性变换推广为神经编码器。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec12-11bdb82708",
          "anchor": {
