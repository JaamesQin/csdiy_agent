  "glossary": [
    {
      "term": "metric learning",
      "definition": "根据相似性信息学习表示距离。"
    },
    {
      "term": "positive pair",
      "definition": "希望表示靠近的样本对。"
    },
    {
      "term": "negative pair",
      "definition": "希望表示分离的样本对。"
    },
    {
      "term": "hard negative",
      "definition": "当前比正例更靠近 anchor 的负例。"
    },
    {
      "term": "projection head",
      "definition": "承受对比损失的小型表示变换网络。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "输入空间距离天然符合语义。",
      "correction": "度量学习用于学习任务相关距离。"
    },
    {
      "misconception": "任意增强都可作为正对。",
      "correction": "增强会定义学习到的不变性。"
    },
    {
      "misconception": "批内随机负例一定是真负例。",
      "correction": "随机负例可能包含 false negatives。"
    }
  ],
