            "value": 16
          }
        }
      ]
    },
    {
      "id": "c3",
      "term": "三元组与困难负样本",
      "claim_type": "source_summary",
      "explanation": "三元组约束要求 anchor 更接近 positive、远离 negative，并保留 margin；困难负例是当前放得比正例更近的负样本。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec12-11bdb82708",
          "anchor": {
            "type": "page",
            "value": 18
