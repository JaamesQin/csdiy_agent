  "glossary": [
    {
      "term": "scaling law",
      "translation": "缩放律",
      "definition": "性能随数据、参数或计算资源变化的经验关系。"
    },
    {
      "term": "scaling exponent",
      "translation": "缩放指数",
      "definition": "幂律中控制资源增加时损失下降速度的 α。"
    },
    {
      "term": "compute-optimal allocation",
      "translation": "计算最优分配",
      "definition": "指定预算和拟合假设下选择参数量与数据量。"
    },
    {
      "term": "extrapolation",
      "translation": "外推",
      "definition": "用已观测尺度预测更大或不同尺度。"
    },
    {
      "term": "intrinsic dimension",
      "translation": "内在维度",
      "definition": "特定表示、数据和任务下的有效流形维度。"
    },
    {
      "term": "representation kernel",
      "translation": "表示核",
      "definition": "以嵌入内积描述样本对相似性。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "log-log图拟合良好就能无限外推。",
      "correction": "高预算可能弯曲且中间尺度证据不足。"
    },
    {
      "misconception": "两组指数是永久最佳比例。",
      "correction": "它们来自不同实验制度。"
    },
    {
      "misconception": "α≈4/d 已解释所有缩放律。",
      "correction": "课件明确称为假说。"
    },
    {
      "misconception": "最大 batch 总同时节省时间和计算。",
      "correction": "存在噪声、步数、通信和墙钟权衡。"
    }
  ],
