    {
      "id": "concept-2",
      "term": "单变量幂律",
      "claim_type": "source_summary",
      "explanation": "若损失拟合为 X^{-α}，资源翻倍使该拟合分量乘 2^{-α}；指数与控制条件依资源类型而异，范围外不保证成立。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec20-f025e970d5",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
