  "core_concepts": [
    {
      "id": "concept-1",
      "term": "表征学习与生成建模",
      "claim_type": "source_summary",
      "explanation": "课件把表征学习画为由数据提取抽象表示，把生成建模画为由抽象变量生成数据；两者可由编码器与生成器联系，但方向和学习问题不同。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 7
          }
        }
      ]
    },
    {
      "id": "concept-2",
      "term": "潜变量边缘似然",
      "claim_type": "source_summary",
      "explanation": "观测 x 的概率通过对潜变量 z 边缘化得到；困难来自对连续潜空间的积分与条件模型的联合训练。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 10
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "p_\\theta(x)=\\int p_\\theta(x\\mid z)p_z(z)\\,dz",
        "citation": {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-3",
      "term": "Monte Carlo 近似",
      "claim_type": "source_summary",
      "explanation": "把先验积分写成先验下的期望，再以独立样本的均值近似。有限 M 是随机估计，不等于逐次都精确求出边缘似然。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 13
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "p_\\theta(x)=\\mathbb{E}_{z\\sim p_z}[p_\\theta(x\\mid z)]\\approx \\frac{1}{M}\\sum_{j=1}^{M}p_\\theta(x\\mid z^{(j)}),\\quad z^{(j)}\\sim p_z",
        "citation": {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 13
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-4",
      "term": "重要性采样",
      "claim_type": "source_summary",
      "explanation": "课件先用真实后验改写期望，说明应从更贴近给定 x 的区域采样；实际 VAE 再以编码器产生的 q_ψ(z|x) 近似这一分布。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 22
          }
        },
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 27
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "p_\\theta(x)=\\mathbb{E}_{z\\sim p_\\theta(Z\\mid x)}\\!\\left[\\frac{p_z(z)}{p_\\theta(z\\mid x)}p_\\theta(x\\mid z)\\right]",
        "citation": {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        "warnings": [
          "该页使用真实后验 p_θ(z|x) 作推导性理想分布；真实后验通常不可直接计算，不能把它当成可用训练算法。"
        ]
      }
    },
    {
      "id": "concept-5",
      "term": "近似后验编码器",
      "claim_type": "source_summary",
      "explanation": "编码器用输入 x 预测高斯分布的参数，从而为每个数据点给出 q_ψ(Z|x)，把固定先验采样转为数据依赖采样。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 22
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "q_\\psi(Z\\mid x)=\\mathcal{N}(f_\\psi^\\mu(x),f_\\psi^\\Sigma(x))",
        "citation": {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 22
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-6",
      "term": "证据下界（ELBO）",
      "claim_type": "source_summary",
      "explanation": "课件通过 Jensen 不等式得到可优化下界：重构期望鼓励潜变量解释 x，KL 项把近似后验约束到先验附近。最大化该目标不等于保证模型或表示满足所有理想性质。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 25
          }
        }
      ],
      "formula": {
        "status": "resolved",
        "latex": "\\mathcal{J}=\\mathbb{E}_{z\\sim q_\\psi(Z\\mid x)}[\\log p_\\theta(x\\mid z)]-D_{KL}(q_\\psi(Z\\mid x)\\Vert p_z)",
        "citation": {
          "source_id": "mit6-7960-f24-lec15-1b6adcad79",
          "anchor": {
            "type": "page",
            "value": 25
          }
        },
        "warnings": []
      }
    },
    {
      "id": "concept-7",
      "term": "Gaussian bottleneck",
      "claim_type": "source_summary",
      "explanation": "低维且随机的高斯瓶颈支持从分布采样。课件用图示表达连续潜空间动机，但没有给出“必然解耦”的定理或保证。",
