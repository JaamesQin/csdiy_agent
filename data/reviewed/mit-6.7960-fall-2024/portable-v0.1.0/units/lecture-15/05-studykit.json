  "glossary": [
    {
      "term": "latent variable",
      "translation": "潜变量",
      "definition": "未直接观测、用于解释或生成观测 x 的变量 z。"
    },
    {
      "term": "proposal distribution",
      "translation": "提议分布",
      "definition": "重要性采样中实际取样的分布。"
    },
    {
      "term": "approximate posterior",
      "translation": "近似后验",
      "definition": "由编码器参数化、用于近似难算真实后验的 q_ψ(z|x)。"
    },
    {
      "term": "ELBO",
      "translation": "证据下界",
      "definition": "由重构期望减去 KL 散度构成的可优化下界。"
    },
    {
      "term": "Gaussian bottleneck",
      "translation": "高斯瓶颈",
      "definition": "以高斯分布参数化的随机低维潜表示。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "Monte Carlo 有限样本均值就是精确边缘似然。",
      "correction": "它是随机近似，精度随样本与方差而变。"
    },
    {
      "misconception": "推导里的真实后验可直接作为训练时提议分布。",
      "correction": "VAE 的关键是用 q_ψ(z|x) 近似难算真实后验。"
    },
    {
      "misconception": "Gaussian bottleneck 自动保证语义解耦。",
      "correction": "课件图示只提供结构动机，未给出此保证。"
    },
    {
      "misconception": "ELBO 最大化等同于精确最大化 log p_θ(x)。",
      "correction": "ELBO 是下界；间隙取决于近似后验。"
    }
  ],
