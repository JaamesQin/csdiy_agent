  "common_misconceptions": [
    {
      "misconception": "Newton 步总是朝局部极小值移动。",
      "correction": "幻灯片明确指出它可能收敛到局部极大值，并提及可用三次正则化处理。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec7-d9137f6191",
          "anchor": {
            "type": "page",
            "value": 12
          }
        }
      ]
    },
    {
      "misconception": "Gauss–Newton 就是完整 Newton 法，只是换了名字。",
      "correction": "它在复合 Hessian 中忽略模型曲率项；幻灯片把这样做是否安全列为问题。",
      "citations": [
