  "practice": [
    {
      "id": "p1-objective",
      "level": "基础",
      "question": "用你自己的符号写出 N 个训练样本的经验损失，并逐项说明 f、ℓ、w、x^(i)、y^(i) 的角色；最后加一句说明本讲研究哪种批处理范围。",
      "hint": "先画出“输入—模型—预测—误差”的箭头，再把样本索引放进平均式。",
      "deliverable": "一条带维度/角色注释的损失公式和一句范围声明。",
      "expected_evidence": [
        "平均因子 1/N",
        "模型输出与目标进入误差函数",
        "明确 full-batch 范围"
      ],
      "evaluation": {
        "criteria": [
          "符号自洽",
          "角色无混淆",
          "范围没有外推到 mini-batch"
        ],
        "self_check": "逐项对照第 4、6 页，不照抄原句。"
      },
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec7-d9137f6191",
