  "core_concepts": [
    {
      "id": "c1-architecture-bias",
      "term": "假设空间与架构约束",
      "claim_type": "source_summary",
      "explanation": "讲义用图示表达一个定性观点：更多数据会缩小“与数据相符”的解集合；更受约束的架构则缩小假设空间。两条路径都可能帮助学习解靠近真实解。讲义把好的架构描述为既能表示目标函数、又尽量精简，并便于基于梯度的搜索、并行和 GPU 计算；这不是形式化定理。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec4-8bddd7b92d",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        {
          "source_id": "mit6-7960-f24-lec4-8bddd7b92d",
          "anchor": {
            "type": "page",
            "value": 6
          }
        },
        {
          "source_id": "mit6-7960-f24-lec4-8bddd7b92d",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ]
    },
    {
      "id": "c2-equivariance-segmentation",
      "term": "语义分割与平移等变",
      "claim_type": "source_summary",
      "explanation": "小 patch 能提高输出网格分辨率，却可能缺少识别所需上下文；讲义因而转向大而重叠的 patch，并把逐像素类别图称为语义分割。平移等变表示：输入平移后，输出按同样方式平移，而不是输出保持不变。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec4-8bddd7b92d",
          "anchor": {
            "type": "page",
            "value": 19
          }
        },
