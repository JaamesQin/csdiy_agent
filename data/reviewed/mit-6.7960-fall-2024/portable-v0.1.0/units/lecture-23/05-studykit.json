  "glossary": [
    {
      "term": "sharpness",
      "translation": "陡峭度",
      "definition": "二阶损失变化相对于所选范数的上界常数。"
    },
    {
      "term": "well-normed module",
      "translation": "良好定范模块",
      "definition": "一阶输入与权重敏感性满足指定界的模块。"
    },
    {
      "term": "module mass",
      "translation": "模块质量参数",
      "definition": "组合规则中分配权重尺度的正数属性。"
    },
    {
      "term": "duality map",
      "translation": "对偶映射",
      "definition": "在范数单位球上最大化与梯度内积的映射。"
    },
    {
      "term": "spectral norm",
      "translation": "谱范数",
      "definition": "矩阵作为线性算子的最大伸缩率。"
    },
    {
      "term": "learning-rate transfer",
      "translation": "学习率迁移",
      "definition": "尺度变化后仍可沿用合适学习率的性质。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "梯度下降方向与参数范数无关。",
      "correction": "最陡方向由所选范数及其对偶几何决定。"
    },
    {
      "misconception": "每层有界即可自动保证任意组合紧且无量纲。",
      "correction": "需要明确的组合规则和属性传播。"
    },
    {
      "misconception": "第 34 页证明学习率在所有设置都能迁移。",
      "correction": "该页是特定训练设置的实验结果。"
    },
    {
      "misconception": "第 47 页已经解决低精度鲁棒性。",
      "correction": "该页明确把它列为未来问题。"
    }
  ],
