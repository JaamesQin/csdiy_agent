  "core_concepts": [
    {
      "id": "concept-1",
      "term": "范数下的陡峭下降",
      "claim_type": "source_summary",
      "explanation": "二阶 Taylor 上界把损失变化写成梯度线性项与由 sharpness λ、权重范数平方控制的二次项。选择不同范数会改变单位球上的最陡方向，因此优化步骤应与参数空间几何匹配。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 36
          }
        }
      ]
    },
    {
      "id": "concept-2",
      "term": "网络 Taylor 控制",
      "claim_type": "source_summary",
      "explanation": "对复合损失 L=ℓ∘f，Gauss–Newton 分解把 Hessian 二次型分为网络二阶导数与损失二阶导数相关的两部分。目标是构造权重范数，同时控制 f 对权重扰动的一阶响应和二阶响应。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 12
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 13
          }
        }
      ]
    },
    {
      "id": "concept-3",
      "term": "度量化模块",
      "claim_type": "source_summary",
      "explanation": "模块包含输入、权重和输出空间，以及 forward、sensitivity、mass 和权重 norm 属性。well-normed 条件约束输入与权重微扰的一阶输出变化；原子、无权重 bond 与复合模块通过组合规则构建网络。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 20
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 23
          }
        }
      ]
    },
    {
      "id": "concept-4",
      "term": "模块 sharpness 与组合",
      "claim_type": "source_summary",
      "explanation": "(α,β,γ)-sharp 分别控制权重—权重、输入—权重和输入—输入二阶导数。讲义主张这些属性具有结合式组合律，从而可由层级属性推导复合网络的二阶控制。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 24
          }
        }
      ]
    },
    {
      "id": "concept-5",
      "term": "尺度与学习率迁移",
      "claim_type": "source_summary",
      "explanation": "讲义的尺度论点是：若 Lipschitz 常数不依赖宽度、深度等尺度且界在尺度变化时保持紧，那么控制模块权重扰动范数即可稳定控制输出变化，进而支持学习率迁移。第 34 页曲线是特定 GPT/OpenWebText 设置下的实验支持，不是普遍保证。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 29
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 34
          }
        }
      ]
    },
    {
      "id": "concept-6",
      "term": "模块化对偶与 Shampoo",
      "claim_type": "source_summary",
      "explanation": "对偶映射在所选范数单位球上最大化梯度内积。模块化对偶先求每层映射，再按串联和并联结构递归组合；矩阵层的 Shampoo 核心步骤可解释为谱范数下的陡峭下降。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
            "type": "page",
            "value": 36
          }
        },
        {
          "source_id": "mit6-7960-f24-lec23-5bf8a70ae9",
          "anchor": {
