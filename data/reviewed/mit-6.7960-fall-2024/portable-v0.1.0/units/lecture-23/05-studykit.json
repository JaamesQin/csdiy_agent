  "learning_objectives": [
    {
      "id": "obj-1",
      "objective": "解释权重范数如何控制网络 Taylor 展开及陡峭下降。"
    },
    {
      "id": "obj-2",
      "objective": "从 Gauss–Newton 分解识别 Lipschitz 与 Lipschitz-smooth 条件。"
    },
    {
      "id": "obj-3",
      "objective": "描述模块、well-normed 属性、sharpness 与组合器。"
    },
    {
      "id": "obj-4",
      "objective": "说明无量纲且紧的界为何被用于主张学习率跨尺度迁移。"
    },
    {
      "id": "obj-5",
      "objective": "推导对偶映射并联系谱范数陡峭下降与 Shampoo。"
    },
    {
      "id": "obj-6",
      "objective": "区分理论命题、特定实验结果和未来开放问题。"
    }
  ],
  "prerequisites": [
