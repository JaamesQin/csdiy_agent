  "core_concepts": [
    {
      "id": "concept-1",
      "term": "结构化预测",
      "claim_type": "source_summary",
      "explanation": "结构化输出的各部分存在依赖；只独立惩罚每个元素可能无法表达整体真实感或一致性。课件用图像输出说明这一动机。",
      "citations": [
        {
          "source_id": "mit6-7960-f24-lec16-3886541007",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
