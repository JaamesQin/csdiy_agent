  "glossary": [
    {
      "term": "structured prediction",
      "translation": "结构化预测",
      "definition": "输出由相互依赖的多个部分组成的预测问题。"
    },
    {
      "term": "conditional GAN",
      "translation": "条件生成对抗网络",
      "definition": "在条件输入下训练生成器与判别器的生成模型。"
    },
    {
      "term": "L1 loss",
      "translation": "L1 损失",
      "definition": "按绝对差度量预测与成对目标逐元素偏差的损失。"
    },
    {
      "term": "multimodal output",
      "translation": "多模态输出",
      "definition": "同一条件下存在多个具有显著差异的合理输出模式。"
    },
    {
      "term": "autoregressive model",
      "translation": "自回归模型",
      "definition": "按先前元素或上下文条件化下一元素分布的模型。"
    },
    {
      "term": "unpaired translation",
      "translation": "无配对翻译",
      "definition": "训练数据没有样本级输入—目标一一对应的跨域映射设置。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "第20页 d_φ 表示样本为真的概率。",
      "correction": "该页标签明确把高值对应 synthetic；读公式前必须先声明约定。"
    },
    {
      "misconception": "L1 加对抗损失在任何任务上都保证稳定且快速收敛。",
      "correction": "页面表述是课程设定下的经验性主张，不是普遍保证。"
    },
    {
      "misconception": "一个输入只能有一个正确输出。",
      "correction": "条件生成常面对多个合理输出，需要表示不确定性或多模态。"
    },
    {
      "misconception": "无配对翻译证明任何任务都不需要配对监督。",
      "correction": "结论仅限满足额外数据和建模假设的特定任务。"
    }
  ],
