  "core_concepts": [
    {
      "id": "concept-01",
      "term": "写前日志与提交点",
      "claim_type": "source_summary",
      "explanation": "事务先把修改块写入日志，再写入描述已提交内容的记录；只有完成提交后才允许把修改安装到文件系统 home 位置。崩溃后，恢复程序重放已提交事务并忽略未完成事务，使多步元数据更新表现为全有或全无。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "concept-02",
      "term": "异步、批处理与并发事务",
      "claim_type": "source_summary",
      "explanation": "系统调用先修改缓存并快速返回，日志可定期批量提交。批处理摊薄描述/提交与寻道成本，并吸收对同一块的多次修改；开放、提交、写回和释放阶段可重叠。但崩溃可能遗失最近已返回的调用，要求需要持久保证的应用显式使用 fsync。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "concept-03",
      "term": "循环日志恢复与事务隔离",
      "claim_type": "source_summary",
      "explanation": "恢复从日志超级块记录的最老事务开始，依据 magic、序列号和 commit 找到最后完整事务，按顺序重放。重放可重复执行；事务间还要防止后续系统调用的缓存修改被前一事务错误写入日志，因此关闭/快照边界对一致性很重要。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "id": "concept-04",
      "term": "ordered data 与日志空间安全",
      "claim_type": "source_summary",
      "explanation": "ordered data 不把文件内容写入日志，而是在提交相关元数据前先把内容写到 home 位置，避免元数据指向旧数据。块类型改变与重用需要延迟或 revoke 记录；日志空间预留防止尚未写回的旧版本丢失。设备写缓存可能重排写入，事务校验和可帮助恢复判断提交记录与数据是否匹配。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 5
          }
        }
      ]
    }
  ],
  "glossary": [
    {
      "term": "write-ahead rule（写前规则）",
      "definition": "在把修改写回文件系统 home 位置前，先把事务完整提交到磁盘日志。",
      "pages": [
        1
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "term": "commit point（提交点）",
      "definition": "事务的 commit 记录完成持久化、恢复因此把它视为已提交的边界。",
      "pages": [
        1,
        2
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "term": "write absorption（写吸收）",
      "definition": "一个批次内多次修改同一块时，只需为最终缓存版本安排较少磁盘写。",
      "pages": [
        2
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "term": "revoke record",
      "definition": "恢复时阻止重放某个旧日志块的记录，用于块被重新解释或重用的情形。",
      "pages": [
        4
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "系统调用返回就一定表示数据已经安全写入磁盘。",
      "correction": "异步更新可能在崩溃后遗失最近完成的调用；需要持久保证的应用要使用 fsync。",
      "pages": [
        2
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "misconception": "找到日志中的 descriptor 就可以重放该事务。",
      "correction": "恢复必须确认事务具有完整有效的 commit，并忽略最后的部分事务。",
      "pages": [
        3
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "misconception": "ordered data 可以在任意时刻写文件内容。",
      "correction": "内容必须在相关元数据 commit 前写入，避免恢复后 inode 指向旧或他人数据。",
      "pages": [
        4
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    }
  ],
