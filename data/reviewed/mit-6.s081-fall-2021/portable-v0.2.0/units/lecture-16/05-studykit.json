  "practice": [
    {
      "id": "practice-01",
      "level": "trace",
      "objective_ids": [
        "obj-1"
      ],
      "question": "追踪一个同时更新 inode 与空闲位图的事务：日志数据、commit、home 写入、日志释放依次何时发生？分别分析在四个边界崩溃后的恢复结果。",
      "hint": "先标出 write-ahead rule 和 freeing rule。",
      "deliverable": "事件时间线和四个崩溃点结果表。",
      "expected_evidence": [
        "未 commit 事务不安装",
        "已 commit 事务可重放",
        "home 完成前不释放日志"
      ],
      "evaluation": {
        "full_credit": "四个崩溃点均保持全有或全无的不变量。",
        "partial_credit": "主顺序正确，但一个恢复边界解释不完整。"
      },
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-16-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
