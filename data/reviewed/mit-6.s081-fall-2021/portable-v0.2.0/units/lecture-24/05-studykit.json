  "glossary": [
    {
      "term_en": "Fault injection",
      "term_zh": "故障注入",
      "definition": "人为改变状态以模拟故障。"
    },
    {
      "term_en": "Scrubber",
      "term_zh": "巡检修复任务",
      "definition": "检查并修复位翻转的任务。"
    },
    {
      "term_en": "Watchdog",
      "term_zh": "看门狗",
      "definition": "未收到健康信号时强制重置的外部设备。"
    },
    {
      "term_en": "Kernel-only reboot",
      "term_zh": "仅重启内核",
      "definition": "重载内核并尝试保留进程 RAM 状态。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "不崩溃就等于任务正确。",
      "correction": "需要自动连续验证具体需求。"
    },
    {
      "misconception": "三副本覆盖任意故障。",
      "correction": "它依赖单错/随机假设且投票器仍需保护。"
    },
    {
      "misconception": "极小内核能直接取代通用 OS。",
      "correction": "它依赖固定任务和静态资源。"
    },
    {
      "misconception": "幻灯片已证明提案有效。",
      "correction": "研究进行中，结论明确待验证。"
    }
  ],
