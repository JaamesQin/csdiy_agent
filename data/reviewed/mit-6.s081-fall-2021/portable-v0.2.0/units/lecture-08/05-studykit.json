  "prerequisites": [
    {
      "topic": "多级页表",
      "required_level": "理解虚拟地址经页表映射到物理页，并知道 PTE 包含权限/状态位。"
    },
    {
      "topic": "系统调用",
      "required_level": "理解用户态进入内核态存在固定开销。"
    },
    {
      "topic": "垃圾回收基础",
      "required_level": "知道根集合、可达性和对象分代的基本含义。"
    }
  ],
