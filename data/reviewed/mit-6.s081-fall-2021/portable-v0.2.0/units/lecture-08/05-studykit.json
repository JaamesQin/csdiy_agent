  "glossary": [
    {
      "term": "VDSO",
      "definition": "内核向用户地址空间提供的数据/代码机制，用于减少部分简单查询的系统调用开销。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ]
    },
    {
      "term": "accessed bit",
      "definition": "页被读或写后由硬件标记的 PTE 状态位。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 15
          }
        }
      ]
    },
    {
      "term": "dirty bit",
      "definition": "页发生写入后由硬件标记的 PTE 状态位。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 15
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 24
          }
        }
      ]
    },
    {
      "term": "generational GC",
      "definition": "把对象按年龄分区并更频繁回收年轻对象的收集策略。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 20
          }
        }
      ]
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "任何系统调用都可直接替换成共享内存读取。",
      "correction": "只有无副作用且可安全发布的数据适合；复杂或瞬息变化的内核状态需要额外机制。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "misconception": "PTE_A 只表示写入。",
      "correction": "PTE_A 表示读或写访问；PTE_D 专门表示写入。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 15
          }
        }
      ]
    },
    {
      "misconception": "没有访问位就完全无法检测页面访问。",
      "correction": "可以借助页故障模拟，但代价明显更高。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 19
          }
        }
      ]
    },
    {
      "misconception": "代际 GC 只需扫描年轻代根集合。",
      "correction": "老年代对象可能指向年轻代，必须跟踪这些跨代引用。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 22
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
            "type": "page",
            "value": 23
          }
        }
      ]
    }
  ],
