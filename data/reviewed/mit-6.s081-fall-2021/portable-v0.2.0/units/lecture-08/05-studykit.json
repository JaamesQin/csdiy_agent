  "core_concepts": [
    {
      "id": "c1",
      "term": "USYSCALL 共享页",
      "claim_type": "source_summary",
      "explanation": "对进程生命周期内稳定、无副作用的查询，内核可把数据放在用户可读但不可写的共享页中以避免切换。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-08-material",
          "anchor": {
