  "core_concepts": [
    {
      "id": "concept-01",
      "term": "虚拟机与 VMM 分层",
      "claim_type": "source_summary",
      "explanation": "虚拟机模拟足以运行操作系统的计算机；VMM 位于真实硬件与 guest 之间，可以独立运行或依托 host OS。它让一台物理机运行多个 guest，提供比普通进程更强的隔离，并支持检查点、迁移和内核开发等用途。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "concept-02",
      "term": "trap-and-emulate",
      "claim_type": "source_summary",
      "explanation": "guest 普通指令直接在 CPU 上执行以获得速度，guest 内核则运行在受限模式。执行特权指令时陷入 VMM，VMM 更新虚拟寄存器/模式，必要时转换成真实硬件操作。guest 页表可经 shadow page table 转换 guest VA 到 host PA，设备访问也可通过受控陷阱模拟。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "concept-03",
      "term": "VT-x 与 EPT 两级翻译",
      "claim_type": "source_summary",
      "explanation": "VT-x 提供 root/non-root 模式和 VMCS，使 guest 在 non-root 模式看到一套虚拟控制状态；进入/退出由专门机制管理。EPT 由 VMM 控制，把 guest 物理地址再映射到 host 物理地址，因此 guest 可维护自己的页表，同时仍被限制在 VMM 分配的内存内。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "id": "concept-04",
      "term": "Dune 的用户级特权",
      "claim_type": "source_summary",
      "explanation": "Dune 让普通 Linux 进程进入基于 VT-x 的模式，直接管理自己的页表、处理页故障并在 guest user/supervisor 间切换。笔记用浏览器插件沙箱和利用 PTE dirty bit 的并发垃圾回收说明收益，同时指出 VM 进入/退出、内核故障与 EPT TLB miss 带来的开销。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    }
  ],
  "glossary": [
    {
      "term": "VMM（virtual machine monitor）",
      "definition": "管理 guest 虚拟硬件状态并控制其访问真实硬件的层。",
      "pages": [
        1
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "term": "trap-and-emulate",
      "definition": "敏感 guest 操作触发陷阱，由 VMM 模拟其对虚拟状态或硬件的效果。",
      "pages": [
        2
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "term": "VMCS",
      "definition": "VT-x 中在 non-root 退出和恢复时保存/装载 guest 虚拟状态的控制结构。",
      "pages": [
        3
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "term": "EPT",
      "definition": "VMM 控制的第二级页表，把 guest 物理地址映射到 host 物理地址。",
      "pages": [
        3
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-19-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "虚拟机必须逐条解释所有 guest 指令。",
      "correction": "课程先说明解释器可行但慢，随后采用普通指令直接执行、敏感指令 trap-and-emulate。",
      "pages": [
        1,
        2
