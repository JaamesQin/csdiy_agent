  "glossary": [
    {
      "term_en": "IRQ",
      "term_zh": "中断请求号",
      "definition": "由硬件平台分配、标识中断来源的编号。"
    },
    {
      "term_en": "PLIC",
      "term_zh": "平台级中断控制器",
      "definition": "汇集外部设备中断并分发到处理器核心的控制器。"
    },
    {
      "term_en": "Top half / bottom half",
      "term_zh": "上半部 / 下半部",
      "definition": "调用进程中的生产工作与中断处理中的消费/唤醒工作。"
    },
    {
      "term_en": "Polling",
      "term_zh": "轮询",
      "definition": "处理器主动反复检查设备是否需要服务。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "只要执行 intr_off，所有核心上的共享访问都会停止。",
      "correction": "它只阻止当前核心接收中断；另一核心仍可运行，跨核同步需要锁。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 20
          }
        }
      ]
    },
    {
      "misconception": "中断只会发生在函数调用边界。",
      "correction": "示例说明中断可以发生在相邻汇编指令之间。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 17
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ]
    },
    {
      "misconception": "轮询总是比中断浪费。",
      "correction": "低频事件下轮询浪费明显，但高频事件下轮询可避免每事件中断开销。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
