          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 19
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 20
          }
        }
      ]
    },
    {
      "id": "cc-07",
      "term": "中断与轮询",
      "term_en": "Interrupts and polling",
      "claim_type": "source_summary",
      "explanation": "事件稀少时轮询浪费周期；事件高频时每次中断的固定开销可能过大，现代系统常结合中断、批量工作和轮询。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 21
          }
        },
