            "value": 12
          }
        }
      ]
    },
    {
      "id": "cc-05",
      "term": "生产者—消费者环形缓冲区",
      "term_en": "Producer-consumer ring buffer",
      "claim_type": "source_summary",
      "explanation": "shell 产生字符、UART 消费字符；环形缓冲区吸收速度差，底半部中断处理唤醒等待空间的上半部。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 15
          }
        }
      ]
    },
    {
      "id": "cc-06",
      "term": "中断竞态与本地原子性",
      "term_en": "Interrupt race and local atomicity",
      "claim_type": "source_summary",
      "explanation": "中断可发生在相邻指令之间。intr_off 可让当前核心的一段代码不被中断，但另一核心仍可能并发访问，所以跨核共享数据需要锁。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 17
          }
        },
        {
