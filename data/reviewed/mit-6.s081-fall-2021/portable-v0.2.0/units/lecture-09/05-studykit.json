  "core_concepts": [
    {
      "id": "cc-01",
      "term": "异步中断",
      "term_en": "Asynchronous interrupt",
      "claim_type": "source_summary",
      "explanation": "设备、计时器或其他核心可以在软件运行期间请求处理；UART 以中断通知内核收发进展。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "id": "cc-02",
      "term": "PLIC 与核心本地中断控制器",
      "term_en": "PLIC and core-local interrupt controller",
      "claim_type": "source_summary",
      "explanation": "PLIC 接收外部设备中断并分发到核心；核心本地控制器处理每核计时器和核间相关事件。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "id": "cc-03",
      "term": "中断控制状态",
      "term_en": "Interrupt control state",
      "claim_type": "source_summary",
      "explanation": "sie 选择中断类型，sstatus.SIE 总体开关监管态中断，sip 表示等待类型，scause 记录原因，stvec 指向处理入口。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 7
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ]
    },
    {
      "id": "cc-04",
      "term": "UART 中断路径",
      "term_en": "UART interrupt path",
      "claim_type": "source_summary",
      "explanation": "shell 的 write 经 sys_write、filewrite、uartputc 和 uartstart 把字符交给 UART；设备完成后经 PLIC 触发 CPU 保存状态并跳到 stvec。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-09-material",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
        {
