  "practice": [
    {
      "id": "practice-01",
      "level": "recall",
      "objective_ids": [
        "obj-1"
      ],
      "question": "根据页面列出操作系统的两类主要目的，并为每类各举一个页面中的关键词。",
      "hint": "从 abstraction 与 multiplexing 两组项目入手。",
      "deliverable": "一张两行对照表。",
      "expected_evidence": [
        "正确区分抽象与多路复用",
        "包含隔离或共享的作用"
      ],
      "evaluation": {
        "full_credit": "两类目的和示例均与页面一致，且没有把隔离误作独立硬件资源。",
        "partial_credit": "能说出两类目的，但示例或作用解释不完整。"
      },
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "id": "practice-02",
      "level": "trace",
      "objective_ids": [
        "obj-2"
      ],
      "question": "用四个节点画出用户程序执行 write 时的概念路径：用户空间、系统调用边界、内核、硬件资源。",
      "hint": "页面只要求概念路径，不要求给出真实指令或 ABI。",
      "deliverable": "带箭头的四节点图及每个节点一句说明。",
      "expected_evidence": [
        "边界方向正确",
        "不把用户程序画成直接控制磁盘"
      ],
      "evaluation": {
        "full_credit": "路径和职责清楚，并明确用户程序不能绕过内核直接管理硬件。",
        "partial_credit": "节点齐全但边界或职责有一处含混。"
