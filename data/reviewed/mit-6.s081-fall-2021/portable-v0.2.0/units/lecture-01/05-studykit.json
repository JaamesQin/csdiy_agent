            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 17
          }
        }
      ]
    },
    {
      "id": "concept-04",
      "term": "操作系统设计张力",
      "claim_type": "source_summary",
      "explanation": "操作系统设计同时面对效率与通用性、能力与简洁性、灵活性与安全性的张力；特性交互、调试难度和不断变化的硬件让这些取舍持续存在。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
