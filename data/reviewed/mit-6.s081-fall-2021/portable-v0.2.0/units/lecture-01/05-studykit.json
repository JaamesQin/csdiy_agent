  "core_concepts": [
    {
      "id": "concept-01",
      "term": "抽象与多路复用",
      "claim_type": "source_summary",
      "explanation": "操作系统用进程、内存、文件描述符、目录等抽象隐藏硬件细节，同时让多个应用共享处理器、内存、磁盘和网络；共享必须配合隔离以约束故障与安全风险。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "id": "concept-02",
      "term": "用户态—内核态边界",
      "claim_type": "source_summary",
      "explanation": "应用运行在用户空间，内核运行在内核空间并管理硬件。系统调用是主要接口：表面像函数调用，但会跨越用户与内核保护边界。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 7
          }
        }
      ]
    },
    {
      "id": "concept-03",
      "term": "xv6 教学模型",
      "claim_type": "source_summary",
      "explanation": "课程让学习者扩展小型 xv6，并借 RISC-V 与 QEMU 观察硬件和内核行为。xv6 保留类 UNIX 设计，但规模足够小，便于理解完整系统。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-01-material",
          "anchor": {
