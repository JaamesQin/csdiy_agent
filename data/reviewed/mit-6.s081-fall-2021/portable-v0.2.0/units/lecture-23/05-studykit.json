      "topic": "原子操作与锁",
      "required_level": "理解 CAS、spinlock 和 read/write lock 的基本语义。"
    },
    {
      "topic": "内存顺序",
      "required_level": "知道编译器和 CPU 可能重排独立读写，需要屏障建立 happens-before。"
    },
    {
      "topic": "调度与 context switch",
      "required_level": "理解线程在切换后不再继续使用先前栈上的临时引用。"
    }
  ],
