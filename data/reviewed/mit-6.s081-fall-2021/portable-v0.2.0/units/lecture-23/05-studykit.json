  "core_concepts": [
    {
      "id": "c1",
      "term": "读写锁的缓存行争用",
      "claim_type": "source_summary",
      "explanation": "读锁也会递增共享读者计数，导致每个读者执行写和缓存失效；高核心数下成本会急剧放大。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "c2",
      "term": "复制后单写提交",
      "claim_type": "source_summary",
      "explanation": "RCU 写者不原地修改读者可见对象，而是准备新副本并以一次指针更新作为提交点。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "c3",
      "term": "发布与解引用屏障",
      "claim_type": "source_summary",
      "explanation": "写屏障保证对象初始化先于发布，读屏障保证获取指针先于读取对象内容。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "c4",
      "term": "grace period",
      "claim_type": "source_summary",
      "explanation": "删除可见指针后，写者等待所有可能持旧引用的 CPU 经过 context switch，再安全释放旧对象。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "id": "c5",
      "term": "读侧临界区",
      "claim_type": "source_summary",
      "explanation": "rcu_read_lock/unlock 限定指针可用区间；引用不能跨 yield/sleep 或被返回给区间外代码。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "id": "c6",
      "term": "读优化、写变慢",
      "claim_type": "source_summary",
      "explanation": "RCU 让读路径接近零写入并可与写并发，但写者需要复制、同步和延迟回收，适合读远多于写的结构。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "id": "c7",
      "term": "per-core 分区",
      "claim_type": "source_summary",
      "explanation": "写频繁时可把状态拆为每核私有/半私有分区，使本地写便宜，并把昂贵聚合移到稀少的读操作。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    }
  ],
  "glossary": [
    {
      "term": "RCU",
      "definition": "Read-Copy Update；以复制发布和延迟回收换取近乎无写的读路径。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-23-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
