  "core_concepts": [
    {
      "id": "concept-01",
      "term": "虚拟内存的隔离间接层",
      "claim_type": "source_summary",
      "explanation": "每个进程使用自己的虚拟地址空间；软件访问虚拟地址，MMU 按内核配置的页表转换为物理地址，并利用权限限制用户访问内核或其他进程内存。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 7
          }
        }
      ]
    },
    {
      "id": "concept-02",
      "term": "Sv39 三级页表",
      "claim_type": "source_summary",
      "explanation": "课程使用 Sv39：虚拟地址按页内偏移和虚拟页号划分，三级页表逐层使用索引查找 PTE。PTE 包含物理页号及有效、用户、读写执行等权限信息；多级结构避免为未使用的地址范围预留完整平面数组。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 9
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 10
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 13
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 14
          }
        }
      ]
    },
    {
      "id": "concept-03",
      "term": "satp、页表遍历与 TLB",
      "claim_type": "source_summary",
      "explanation": "satp 指向当前页表根，硬件在需要时遍历页表，TLB 缓存近期翻译。PTE 被移除、权限变化或切换页表根后，旧 TLB 项可能失效，软件必须按架构规则使缓存翻译失效。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 16
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 17
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ]
    },
    {
      "id": "concept-04",
      "term": "xv6 地址空间实践",
      "claim_type": "source_summary",
      "explanation": "xv6 为每个进程维护页表，并在进程切换时更换页表根；trampoline 在各页表的同一位置映射且必须可执行、不可写。分页还为写时复制、惰性分配和进程堆调整提供基础。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 20
          }
        },
