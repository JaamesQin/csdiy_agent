  "common_misconceptions": [
    {
      "misconception": "虚拟地址就是物理 RAM 中的同一个数值位置。",
      "correction": "MMU 通过页表把虚拟地址映射到物理地址，二者之间存在受控间接层。",
      "pages": [
        7
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 7
          }
        }
      ]
    },
    {
      "misconception": "修改 PTE 后 TLB 一定会自动立即更新。",
      "correction": "TLB 可能保留旧翻译，材料要求软件处理失效条目。",
      "pages": [
        18
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-04-material",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ]
    },
    {
      "misconception": "trampoline 既要执行就也必须可写。",
      "correction": "页面给出的结论是必须可执行但不可写。",
