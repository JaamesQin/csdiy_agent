  "prerequisites": [
    {
      "topic": "页表与页故障",
      "required_level": "理解保护位、缺页陷入和重新执行故障指令。"
    },
    {
      "topic": "UNIX 进程信号",
      "required_level": "知道内核可把异常转换为用户态信号处理器调用。"
    },
    {
      "topic": "垃圾回收",
      "required_level": "理解根集合、可达对象、复制收集和 mutator/collector 的区别。"
    }
  ],
  "outline": [
    {
      "order": 1,
      "topic": "用户级 VM 原语与现代接口",
