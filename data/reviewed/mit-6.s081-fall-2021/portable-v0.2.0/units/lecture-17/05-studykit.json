  "core_concepts": [
    {
      "id": "c1",
      "term": "VMA",
      "claim_type": "source_summary",
      "explanation": "VMA 描述一段连续虚拟地址的权限和后备对象，内核据此决定页故障应调页、发信号还是终止。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "c2",
      "term": "用户态页故障 upcall",
      "claim_type": "source_summary",
      "explanation": "内核保存用户状态并通知用户处理器；处理器修复页面权限后返回，内核再恢复或重启故障指令。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "c3",
      "term": "用户级 VM 原语",
      "claim_type": "source_summary",
      "explanation": "保护、解除保护、脏页查询和别名映射等原语让应用把硬件页机制用于 GC、checkpoint 和按需数据。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "c4",
      "term": "Baker 复制式并发 GC",
      "claim_type": "source_summary",
      "explanation": "对象从 from-space 复制到 to-space，以转发指针连接旧位置和新副本，并逐步扫描未扫描区域。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "c5",
      "term": "页故障作为读屏障",
      "claim_type": "source_summary",
      "explanation": "把未扫描区域设为不可访问，应用首次触碰页面时由处理器扫描该页并解除保护，从而避免每次解引用的显式测试。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "c6",
      "term": "机制与性能权衡",
      "claim_type": "source_summary",
      "explanation": "VM 方案减少编译器插桩但要求高效陷入与 OS 支持；故障频率、页面扫描时间和抽象开销决定收益。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    }
  ],
  "glossary": [
    {
      "term": "VMA",
      "definition": "具有统一权限和后备对象的一段连续虚拟地址区域。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "term": "mutator",
      "definition": "分配并修改对象的应用线程，与垃圾收集器并发执行。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "term": "from-space",
      "definition": "复制收集开始时保存旧对象、最终可整体回收的区域。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "term": "to-space",
      "definition": "接收存活对象副本并分为 scanned/unscanned/new 的区域。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "mmap 只能映射文件。",
      "correction": "匿名映射也可通过 MAP_ANONYMOUS 建立。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "misconception": "用户页故障处理器返回即可，不必修复权限。",
      "correction": "若不解除保护，重启的指令会再次触发同一故障。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "misconception": "并发 GC 使用 VM 后完全没有同步。",
      "correction": "仍需协调由哪个线程扫描哪个页。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "misconception": "页故障方案必然比显式检查快。",
      "correction": "收益取决于陷入、扫描、故障频率和并行扫描等具体成本。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-17-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    }
  ],
