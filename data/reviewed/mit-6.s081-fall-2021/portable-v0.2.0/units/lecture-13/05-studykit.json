    {
      "id": "practice-03",
      "level": "analysis",
      "objective_ids": [
        "obj-3"
      ],
      "question": "为建立共享、处理故障、释放页面、内核 copyout 四种场景分别写出引用计数必须防止的错误。",
      "hint": "只讨论责任和不变量，不列函数补丁。",
      "deliverable": "场景—风险—所需计数动作表。",
      "expected_evidence": [
        "防止过早释放",
        "防止泄漏",
        "内核写入也遵守 COW"
