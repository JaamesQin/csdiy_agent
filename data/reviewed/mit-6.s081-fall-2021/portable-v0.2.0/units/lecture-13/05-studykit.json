  "practice": [
    {
      "id": "practice-01",
      "level": "explanation",
      "objective_ids": [
        "obj-1"
      ],
      "question": "用 fork 后立即 exec 的事件序列说明：传统复制在哪一步发生、哪些数据随后被丢弃、COW 把成本推迟到什么事件。",
      "hint": "只写概念事件，不使用课程实验代码。",
      "deliverable": "五步事件时间线。",
      "expected_evidence": [
        "指出 exec 丢弃旧地址空间",
        "指出写故障才触发复制"
      ],
      "evaluation": {
        "full_credit": "传统与 COW 两条时间线的成本位置均准确。",
        "partial_credit": "能解释 COW 节省复制，但缺少 exec 的作用。"
      },
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-13-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        }
      ]
    },
    {
      "id": "practice-02",
      "level": "trace",
      "objective_ids": [
        "obj-2"
      ],
      "question": "追踪父进程和子进程共享一页后，子进程首次写入的 PTE/物理页状态：写前、故障、复制、写后各是什么？",
      "hint": "把两边映射和物理页分开画。",
      "deliverable": "四阶段状态表。",
      "expected_evidence": [
        "写前共享只读",
        "子进程获得新可写页",
        "父进程仍指向原页"
      ],
      "evaluation": {
        "full_credit": "四阶段及双方映射均正确。",
        "partial_credit": "主流程正确但遗漏父进程最终状态。"
      },
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-13-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
