  "core_concepts": [
    {
      "id": "concept-01",
      "term": "竞态条件与丢失更新",
      "claim_type": "source_summary",
      "explanation": "多核让多个系统调用并行访问共享数据。哈希表中两个 put 若同时读取同一 bucket 头并随后写回，最后写入者可能覆盖另一更新；只要某种合法交错会破坏结果，就存在竞态。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 7
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 8
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 9
          }
        }
      ]
    },
    {
      "id": "concept-02",
      "term": "临界区与不变量",
      "claim_type": "source_summary",
      "explanation": "acquire/release 把一段多步操作变为其他线程不可见的临界区。锁不自动绑定数据；程序员必须识别共享写入和跨字段不变量，并在释放前恢复不变量，从而隐藏暂时不一致状态。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 12
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 13
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 14
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 15
          }
        }
      ]
    },
    {
      "id": "concept-03",
      "term": "死锁与全局加锁顺序",
      "claim_type": "source_summary",
      "explanation": "两个执行流若以相反顺序各持一个锁再等待另一个，会永久等待。统一锁获取顺序可打破这种循环，但要求模块间暴露部分锁依赖，因此会牺牲封装与模块化。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 16
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 17
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 18
          }
        }
      ]
    },
    {
      "id": "concept-04",
      "term": "锁实现与粒度取舍",
      "claim_type": "source_summary",
      "explanation": "粗粒度锁易推理但限制并行，细粒度锁提高并行度却增加不变量和死锁复杂度。真实锁需要原子读改写及获取/释放顺序保证；短临界区适合自旋，长等待通常需要可阻塞方案，而每核数据、RCU 或无锁算法可减少共享。",
      "citations": [
