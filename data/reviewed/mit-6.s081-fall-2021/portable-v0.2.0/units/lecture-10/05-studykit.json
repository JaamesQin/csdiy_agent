  "practice": [
    {
      "id": "practice-01",
      "level": "trace",
      "objective_ids": [
        "obj-1"
      ],
      "question": "逐行交错两个对同一 bucket 执行的 put：两者先读取旧头，再分别链接并写回。指出哪一步让一个 key 消失。",
      "hint": "把每次 READ/WRITE 写成时间线，不假定线程连续执行。",
      "deliverable": "两列时间线和丢失更新说明。",
      "expected_evidence": [
        "两个线程读取同一旧头",
        "最后写回覆盖另一头指针"
      ],
      "evaluation": {
        "full_credit": "交错完整且准确指出最后写入者覆盖。",
        "partial_credit": "知道会丢失更新，但时间线缺少关键读或写。"
      },
