  "glossary": [
    {
      "term": "race condition（竞态条件）",
      "definition": "至少一种可能交错会导致不正确行为的并发情形。",
      "pages": [
        8
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 8
          }
        }
      ]
    },
    {
      "term": "critical section（临界区）",
      "definition": "在锁保护下执行、同一时刻只允许一个持锁者进入的代码区域。",
      "pages": [
        12
      ],
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-10-material",
          "anchor": {
            "type": "page",
            "value": 12
          }
        }
      ]
    },
    {
      "term": "deadlock（死锁）",
      "definition": "执行流形成循环等待，彼此都无法继续。",
      "pages": [
        16
      ],
      "citations": [
