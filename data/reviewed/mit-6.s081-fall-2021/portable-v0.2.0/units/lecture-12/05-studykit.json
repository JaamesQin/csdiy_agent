  "core_concepts": [
    {
      "id": "cc-01",
      "term": "跨 swtch 的 p->lock",
      "term_en": "p->lock across swtch",
      "claim_type": "source_summary",
      "explanation": "内核线程设置 RUNNABLE 后仍需保存上下文并离开自己的栈，所以 p->lock 跨 swtch 保持，直到调度器栈一侧释放。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "id": "cc-02",
      "term": "重调度时不得持有其他自旋锁",
      "term_en": "No other spinlock across sched",
      "claim_type": "source_summary",
      "explanation": "若线程持有普通锁进入 sched，之后运行的线程可能等待该锁，而原线程已无法继续释放它，形成死锁。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 5
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        }
      ]
    },
    {
      "id": "cc-03",
      "term": "阻塞式协调",
      "term_en": "Blocking coordination",
      "claim_type": "source_summary",
      "explanation": "等待磁盘、管道、超时或子进程等事件时，阻塞进入调度器可让 CPU 处理其他工作，优于持续空转。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 7
          }
        },
