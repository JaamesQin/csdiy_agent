            "value": 10
          }
        }
      ]
    },
    {
      "id": "cc-04",
      "term": "sleep/wakeup 通道",
      "term_en": "sleep/wakeup channel",
      "claim_type": "source_summary",
      "explanation": "sleep 在不透明 channel 上阻塞并接收保护条件的锁；wakeup 唤醒同 channel 的等待者，可能一次唤醒多个线程。",
      "citations": [
