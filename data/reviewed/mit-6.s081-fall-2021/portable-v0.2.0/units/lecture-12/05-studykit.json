  "practice": [
    {
      "id": "prac-01",
      "level": "入门",
      "objective_ids": [
        "obj-01"
      ],
      "question": "在“内核线程→swtch→调度器线程”图上标出 p->lock 的获得、持续持有和释放位置，并写出每段保护的对象。",
      "hint": "RUNNABLE 状态先改变，但上下文和栈交接尚未结束。",
      "deliverable": "三节点时序图。",
      "expected_evidence": [
        "内核线程获得锁并设置 RUNNABLE。",
        "锁跨 swtch 保持。",
        "调度器在线程已离开其栈且上下文保存后释放。"
      ],
      "evaluation": {
        "full_credit": "位置、顺序和保护原因都准确。",
        "partial_credit": "顺序正确但缺少保护对象。"
      },
      "citations": [
        {
