  "glossary": [
    {
      "term_en": "Channel",
      "term_zh": "通道",
      "definition": "sleep/wakeup 用来标识某个等待条件的不透明数值或指针。"
    },
    {
      "term_en": "Lost wakeup",
      "term_zh": "丢失唤醒",
      "definition": "唤醒发生在等待登记之前，导致等待者永久错过事件。"
    },
    {
      "term_en": "ZOMBIE",
      "term_zh": "僵尸状态",
      "definition": "进程已退出但仍保留退出状态和必要资源，等待父进程 wait。"
    },
    {
      "term_en": "swtch",
      "term_zh": "上下文切换",
      "definition": "保存当前内核线程寄存器并切换到另一上下文的操作。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "锁必须由获得它的同一线程释放，所以 p->lock 跨 swtch 是错误。",
      "correction": "本讲明确使用跨线程交接：内核线程持锁进入 swtch，调度器线程在安全边界后释放。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 3
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 4
          }
        }
      ]
    },
    {
      "misconception": "只要 wakeup 最终执行，就不会丢失事件。",
      "correction": "若 wakeup 发生时线程尚未标记为 SLEEPING，它不会被找到；条件锁用于关闭该窗口。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
            "type": "page",
            "value": 18
          }
        },
        {
          "source_id": "mit-6.s081-f21-lecture-12-material",
          "anchor": {
