    },
    {
      "id": "cc-06",
      "term": "协作式进程终止",
      "term_en": "Cooperative process termination",
      "claim_type": "source_summary",
      "explanation": "kill 先设置标志，让目标在安全点自行停止；exit 留下 ZOMBIE 和退出状态，wait 读取状态后才释放 proc 资源。",
      "citations": [
