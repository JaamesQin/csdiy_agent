          }
        }
      ]
    },
    {
      "id": "cc-05",
      "term": "丢失唤醒",
      "term_en": "Lost wakeup",
      "claim_type": "source_summary",
      "explanation": "若事件在等待者检查条件之后、标记 SLEEPING 之前发生，wakeup 看不到睡眠者。条件锁必须覆盖该窗口，sleep 内部原子地释放锁并睡眠，返回时再重获。",
      "citations": [
        {
