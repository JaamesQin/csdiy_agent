    },
    {
      "id": "cc-05",
      "term": "缓存块钉住",
      "claim_type": "source_summary",
      "explanation": "提交前钉住脏缓存块，防止驱逐把未提交数据提前写回主页。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-15-material",
          "anchor": {
