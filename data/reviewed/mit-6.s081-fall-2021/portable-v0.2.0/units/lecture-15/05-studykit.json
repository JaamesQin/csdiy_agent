  "glossary": [
    {
      "term_en": "Commit",
      "term_zh": "提交",
      "definition": "使完整日志事务成为恢复时必须重放对象的持久事件。"
    },
    {
      "term_en": "Install",
      "term_zh": "安装",
      "definition": "把已提交日志块复制到主页位置。"
    },
    {
      "term_en": "Replay",
      "term_zh": "重放",
      "definition": "恢复时再次安装已提交日志。"
    },
    {
      "term_en": "Pinning",
      "term_zh": "钉住",
      "definition": "暂时禁止缓存块被驱逐。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "一部分日志已写就能开始安装。",
      "correction": "全部日志写和提交标记都必须先持久化。"
    },
    {
      "misconception": "缓存驱逐只影响性能。",
      "correction": "未提交脏块写回会破坏 WAL 原子性。"
    },
    {
      "misconception": "大 write 总是一个事务。",
      "correction": "xv6 可拆分它，崩溃后只保证正确前缀。"
    }
  ],
