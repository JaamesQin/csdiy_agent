  "core_concepts": [
    {
      "id": "cc-01",
      "term": "崩溃一致性",
      "claim_type": "source_summary",
      "explanation": "恢复后的文件系统应保持内部不变量、保留较早操作并避免顺序异常。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-15-material",
          "anchor": {
            "type": "page",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "cc-02",
      "term": "事务",
      "claim_type": "source_summary",
      "explanation": "一次系统调用的多个磁盘写被组织为崩溃意义上的全有或全无单元。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-15-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "cc-03",
      "term": "预写日志",
      "claim_type": "source_summary",
      "explanation": "任何主页安装前，全部更新必须先写入日志并具有持久提交标记。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-15-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "cc-04",
      "term": "提交点与重放",
      "claim_type": "source_summary",
      "explanation": "非零日志头 n 表示提交；恢复重放已提交事务。重复重放结论限于讲义的 fail-stop 磁盘模型。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-15-material",
          "anchor": {
            "type": "page",
            "value": 2
          }
