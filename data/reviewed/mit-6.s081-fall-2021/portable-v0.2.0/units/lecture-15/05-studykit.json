    },
    {
      "id": "cc-06",
      "term": "日志容量与批处理",
      "claim_type": "source_summary",
      "explanation": "xv6 用上界、拆分、并发批处理和写吸收管理有限日志；大 write 拆分后仅保证正确前缀。",
      "citations": [
