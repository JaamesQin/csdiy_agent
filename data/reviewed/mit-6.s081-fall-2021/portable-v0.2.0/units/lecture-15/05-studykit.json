  "practice": [
    {
      "id": "prac-01",
      "level": "入门",
      "question": "分类 create 的 inode 泄漏与目录项指向空闲 inode 两种崩溃状态。",
      "hint": "检查谁引用谁。",
      "deliverable": "两行分类表。",
      "expected_evidence": [
        "泄漏未被引用。",
        "空闲 inode 被目录项引用会破坏不变量。"
      ],
      "evaluation": {
        "full_credit": "类别与原因均准确。",
        "partial_credit": "只判断危险程度。"
      },
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-15-material",
          "anchor": {
