  "core_concepts": [
    {
      "id": "cc-01",
      "term": "多路复用",
      "term_en": "Multiplexing",
      "claim_type": "source_summary",
      "explanation": "操作系统要让多个应用共享处理器、内存和设备；仅要求应用主动让出硬件既无法强制进度，也无法防止内存覆盖。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-03-material",
