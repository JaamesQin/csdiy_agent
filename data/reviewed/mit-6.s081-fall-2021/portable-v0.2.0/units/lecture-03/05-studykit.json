          "source_id": "mit-6.s081-f21-lecture-03-material",
          "anchor": {
            "type": "page",
            "value": 15
          }
        }
      ]
    },
    {
      "misconception": "微内核等于把所有操作系统服务删除。",
      "correction": "服务被移到普通用户进程，通过最小内核提供的进程、内存和 IPC 机制协作。",
      "citations": [
        {
