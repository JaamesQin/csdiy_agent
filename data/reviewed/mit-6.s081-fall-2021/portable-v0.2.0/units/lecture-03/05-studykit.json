  "glossary": [
    {
      "term_en": "Privilege mode",
      "term_zh": "特权级",
      "definition": "CPU 对可执行指令和可访问控制状态施加权限的运行模式。"
    },
    {
      "term_en": "Page table",
      "term_zh": "页表",
      "definition": "把虚拟地址映射到物理地址并定义可访问内存范围的数据结构。"
    },
    {
      "term_en": "System call",
      "term_zh": "系统调用",
      "definition": "用户程序进入内核服务的受控接口。"
    },
    {
      "term_en": "IPC",
      "term_zh": "进程间通信",
      "definition": "微内核中用户空间服务和应用交换消息的机制。"
    },
    {
      "term_en": "Emulation",
      "term_zh": "仿真",
      "definition": "软件忠实执行另一处理器或机器模型的行为。"
    }
  ],
  "common_misconceptions": [
    {
      "misconception": "只要规定应用定期让出 CPU，就能获得强隔离。",
      "correction": "规定属于协作约定；失控或恶意应用可以不让出，而且共享物理内存仍可相互覆盖。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-03-material",
          "anchor": {
            "type": "page",
            "value": 6
          }
        },
