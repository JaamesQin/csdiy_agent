          }
        }
      ]
    },
    {
      "id": "cc-04",
      "term": "系统调用",
      "term_en": "System call",
      "claim_type": "source_summary",
      "explanation": "应用以 ecall 进入预先约定的内核入口；内核再执行服务并验证来自不可信用户程序的参数。",
      "citations": [
