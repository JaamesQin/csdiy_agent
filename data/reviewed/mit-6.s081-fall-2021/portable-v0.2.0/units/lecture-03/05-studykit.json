    },
    {
      "id": "cc-05",
      "term": "可信计算基",
      "term_en": "Trusted computing base",
      "claim_type": "source_summary",
      "explanation": "内核和模式切换路径必须正确，因为其错误可能破坏应用之间以及应用与内核之间的隔离。",
      "citations": [
        {
          "source_id": "mit-6.s081-f21-lecture-03-material",
